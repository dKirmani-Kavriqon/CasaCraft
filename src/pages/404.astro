---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found">
  <section class="wrap nf">
    <p class="eyebrow">Error 404</p>
    <h1 class="display">This page has moved, or never existed.</h1>
    <p class="lead">The link may be old. Everything we make is in the shop.</p>
    <div class="nf__row">
      <a class="btn" href="/shop">Go to the shop</a>
      <a class="link-arrow" href="/">Back to home <Icon name="arrow" size={18} /></a>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
    padding-block: var(--s-10);
  }
  .nf h1 {
    font-size: var(--step-4);
    max-width: 14ch;
  }
  .nf__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-5);
  }
</style>
