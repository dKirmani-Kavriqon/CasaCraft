---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { materials, products, type MaterialFamily } from '../data/catalog';

const families: { name: MaterialFamily; note: string }[] = [
  { name: 'Leather', note: 'Smooth, warm to the touch, and better with age.' },
  { name: 'Bouclé', note: 'A looped cloth with depth you can feel.' },
  { name: 'Solid wood', note: 'Every frame is solid wood. These are the finishes.' },
];
const usedOn = (id: string) => products.filter((p) => p.upholstery === id || p.frame === id || p.alsoUpholstered?.includes(id));
---
<Base title="Material library" description="The leathers, bouclé and solid wood finishes used on Casa Craft furniture, photographed on finished pieces, with care notes.">
  <header class="wrap lib-head">
    <h1 class="display" data-reveal="lines" data-now>Material library</h1>
    <p class="lead" data-reveal="fade">
      Every swatch below is photographed on a finished Casa Craft piece, so what you see is the material as it sits in a room.
      Message us to see any of them in daylight.
    </p>
  </header>

  {
    families.map((f) => (
      <section class="wrap lib-family" aria-labelledby={`fam-${f.name}`}>
        <div class="lib-family__title">
          <h2 id={`fam-${f.name}`}>{f.name}</h2>
          <p class="meta">{f.note}</p>
        </div>
        <ul class="lib-grid" role="list">
          {materials
            .filter((m) => m.family === f.name)
            .map((m) => (
              <li id={m.id} class="lib-tile" data-reveal="fade">
                <div class="lib-tile__img">
                  <Image src={m.swatch} alt={`${m.name} ${m.family.toLowerCase()}, close up`} widths={[360, 540, 720]} sizes="(max-width: 700px) 50vw, 22vw" />
                  <button class="lib-tile__info" type="button" popovertarget={`pop-${m.id}`} aria-label={`About ${m.name}`}>
                    <Icon name="info" size={20} />
                  </button>
                </div>
                <p class="lib-tile__name">{m.name}</p>
                <p class="meta">
                  On{' '}
                  {usedOn(m.id).map((p, i, arr) => (
                    <>
                      <a href={`/product/${p.slug}`}>{p.name}{p.collection === 'Nishat' && p.category !== 'sets' ? `, ${p.variant.split(' ')[0]}` : ''}</a>
                      {i < arr.length - 1 ? ', ' : ''}
                    </>
                  ))}
                </p>
                <div class="lib-pop" id={`pop-${m.id}`} popover>
                  <p class="lib-pop__title">{m.name} <span class="meta">{m.family}</span></p>
                  <p>{m.description}</p>
                  <p class="meta"><strong>Care.</strong> {m.care}</p>
                  <button class="btn btn--ghost btn--small" type="button" popovertarget={`pop-${m.id}`} popovertargetaction="hide">Close</button>
                </div>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .lib-head {
    display: grid;
    gap: var(--s-4);
    padding-block: clamp(var(--s-6), 5vw, var(--s-9)) var(--s-7);
  }
  .lib-head h1 {
    font-size: var(--step-4);
  }
  .lib-head .lead {
    max-width: 52ch;
  }
  .lib-family {
    display: grid;
    grid-template-columns: minmax(180px, 0.6fr) minmax(0, 2.4fr);
    gap: var(--s-6);
    padding-block: var(--s-7);
    border-top: 1px solid var(--line);
  }
  .lib-family__title {
    position: sticky;
    top: calc(var(--header-h) + var(--s-4));
    align-self: start;
    display: grid;
    gap: var(--s-2);
  }
  .lib-family__title h2 {
    font-size: var(--step-2);
    font-weight: 500;
  }
  .lib-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-6) var(--s-3);
  }
  .lib-tile {
    display: grid;
    gap: 2px;
    scroll-margin-top: calc(var(--header-h) + var(--s-4));
  }
  .lib-tile__img {
    position: relative;
    aspect-ratio: 3 / 4;
    margin-bottom: var(--s-3);
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--panel);
  }
  .lib-tile__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }
  .lib-tile:hover .lib-tile__img img {
    transform: scale(1.05);
  }
  .lib-tile:target .lib-tile__img {
    box-shadow: 0 0 0 2px var(--paper), 0 0 0 4px var(--ink);
  }
  .lib-tile__info {
    position: absolute;
    top: var(--s-3);
    right: var(--s-3);
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--glass);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: var(--ink);
    transition: transform var(--t-micro) var(--ease-out);
  }
  .lib-tile__info:hover {
    transform: scale(1.06);
  }
  .lib-tile__name {
    font-weight: 600;
  }
  .lib-tile .meta a {
    color: var(--ink-2);
  }
  .lib-pop {
    width: min(360px, calc(100vw - 2 * var(--gutter)));
    margin: auto;
    padding: var(--s-5);
    border: 0;
    border-radius: var(--r-md);
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-soft), 0 0 0 1px var(--line);
  }
  .lib-pop:popover-open {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    animation: pop-in var(--t-component) var(--ease-out);
  }
  .lib-pop::backdrop {
    background: var(--scrim);
  }
  .lib-pop__title {
    font-size: var(--step-1);
    font-weight: 600;
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }
  @media (max-width: 800px) {
    .lib-family {
      grid-template-columns: 1fr;
    }
    .lib-family__title {
      position: static;
    }
    .lib-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
