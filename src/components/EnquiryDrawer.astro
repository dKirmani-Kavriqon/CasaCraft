---
import Icon from './Icon.astro';
import { brand, instagramDm } from '../data/catalog';
---
<dialog class="drawer" data-enquiry aria-labelledby="enquiry-title">
  <div class="drawer__panel">
    <header class="drawer__head">
      <h2 id="enquiry-title">Your enquiry</h2>
      <button class="icon-btn" type="button" data-enquiry-close aria-label="Close enquiry">
        <Icon name="close" size={22} />
      </button>
    </header>

    <p class="drawer__intro meta">
      Casa Craft pieces are made to order. Add what you like, then send the list to the workshop. We reply with
      lead time, delivery and any changes you would like.
    </p>

    <div class="drawer__body">
      <ul role="list" class="drawer__items" data-enquiry-items></ul>

      <div class="drawer__empty" data-enquiry-empty>
        <p class="drawer__empty-title">Nothing here yet</p>
        <p class="meta">Pieces you add appear here, ready to send to the workshop in one message.</p>
        <a class="btn btn--ghost btn--small" href="/shop">Browse the collection</a>
      </div>

      <p class="drawer__undo" data-enquiry-undo hidden role="status">
        <span data-enquiry-undo-text></span>
        <button type="button" data-enquiry-undo-btn>Undo</button>
      </p>
    </div>

    <footer class="drawer__foot" data-enquiry-foot>
      <div class="drawer__total">
        <span>Estimated total</span>
        <strong class="price" data-enquiry-total>₹0</strong>
      </div>
      <label class="drawer__note">
        <span class="meta">Add a note (optional)</span>
        <textarea rows="2" data-enquiry-note placeholder="Room size, timing, or a different leather"></textarea>
      </label>
      <a class="btn btn--block" href={instagramDm} target="_blank" rel="noopener" data-enquiry-send="instagram">
        <Icon name="instagram" size={18} /> Send on Instagram
      </a>
      {
        brand.whatsapp && (
          <a class="btn btn--ghost btn--block" href={`https://wa.me/${brand.whatsapp}`} target="_blank" rel="noopener" data-enquiry-send="whatsapp">
            <Icon name="whatsapp" size={18} /> Send on WhatsApp
          </a>
        )
      }
      <button class="drawer__copy" type="button" data-enquiry-copy>
        <Icon name="copy" size={16} /> <span data-enquiry-copy-label>Copy enquiry text</span>
      </button>
      <p class="meta drawer__hint" data-enquiry-hint>
        Instagram opens a chat with @{brand.instagram}. Your enquiry is copied, so paste it into the message.
      </p>
    </footer>
  </div>
</dialog>

<template id="enquiry-item">
  <li class="drawer__item">
    <a class="drawer__thumb" data-href><img alt="" width="88" height="88" data-img /></a>
    <div class="drawer__info">
      <a class="drawer__name" data-href data-name></a>
      <span class="meta" data-variant></span>
      <span class="price drawer__price" data-price></span>
    </div>
    <div class="drawer__qty" role="group">
      <button type="button" class="drawer__step" data-dec><span class="visually-hidden">Fewer</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14"/></svg></button>
      <output data-qty aria-live="polite">1</output>
      <button type="button" class="drawer__step" data-inc><span class="visually-hidden">More</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
    </div>
    <button type="button" class="drawer__remove" data-remove>Remove</button>
  </li>
</template>

<style>
  .drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(440px, 100vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-soft);
  }
  .drawer::backdrop {
    background: var(--scrim);
  }
  .drawer[open] {
    animation: drawer-in var(--t-modal) var(--ease-smooth);
  }
  .drawer[open]::backdrop {
    animation: fade-in var(--t-modal) var(--ease-out);
  }
  .drawer.is-closing {
    animation: drawer-out 220ms var(--ease-in) forwards;
  }
  @keyframes drawer-in {
    from { transform: translateX(100%); }
  }
  @keyframes drawer-out {
    to { transform: translateX(100%); }
  }
  @keyframes fade-in {
    from { opacity: 0; }
  }
  .drawer__panel {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    height: 100%;
  }
  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--s-4) var(--s-4) 0 var(--s-5);
  }
  .drawer__head h2 {
    font-size: var(--step-2);
  }
  .drawer__intro {
    padding: var(--s-2) var(--s-5) var(--s-4);
    border-bottom: 1px solid var(--line);
  }
  .drawer__body {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--s-2) var(--s-5);
  }
  .drawer__item {
    display: grid;
    grid-template-columns: 88px 1fr auto;
    grid-template-areas:
      'thumb info info'
      'thumb qty remove';
    gap: var(--s-2) var(--s-4);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--line);
  }
  .drawer__thumb {
    grid-area: thumb;
    border-radius: var(--r-sm);
    background: var(--panel);
    overflow: hidden;
  }
  .drawer__thumb img {
    width: 88px;
    height: 88px;
    object-fit: contain;
    padding: 6px;
  }
  .drawer__info {
    grid-area: info;
    display: grid;
    gap: 2px;
  }
  .drawer__name {
    font-weight: 600;
    text-decoration: none;
  }
  .drawer__price {
    margin-top: var(--s-1);
  }
  .drawer__qty {
    grid-area: qty;
    display: inline-flex;
    align-items: center;
    align-self: end;
    width: fit-content;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
  }
  .drawer__qty output {
    min-width: 2ch;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .drawer__step {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
  }
  .drawer__step:hover {
    background: color-mix(in oklab, var(--ink) 8%, transparent);
  }
  .drawer__step:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .drawer__remove {
    grid-area: remove;
    align-self: end;
    justify-self: end;
    min-height: 40px;
    border: 0;
    background: none;
    color: var(--ink-2);
    font-size: var(--step--1);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .drawer__empty {
    display: grid;
    justify-items: start;
    gap: var(--s-3);
    padding-block: var(--s-7);
  }
  .drawer__empty[hidden] {
    display: none;
  }
  .drawer__empty-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
  }
  .drawer__undo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin-top: var(--s-4);
    padding: var(--s-2) var(--s-2) var(--s-2) var(--s-4);
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--paper);
    font-size: var(--step--1);
  }
  .drawer__undo[hidden] {
    display: none;
  }
  .drawer__undo button {
    min-height: 36px;
    padding: 0 var(--s-4);
    border: 0;
    border-radius: var(--r-pill);
    background: var(--paper);
    color: var(--ink);
    font-weight: 600;
  }
  .drawer__foot {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-5) max(var(--s-5), env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    background: var(--panel);
  }
  .drawer__foot[hidden] {
    display: none;
  }
  .drawer__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .drawer__total strong {
    font-size: var(--step-1);
    font-weight: 600;
  }
  .drawer__note {
    display: grid;
    gap: var(--s-1);
  }
  .drawer__note textarea {
    width: 100%;
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    background: var(--paper);
    resize: vertical;
  }
  .drawer__copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    min-height: 40px;
    border: 0;
    background: none;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .drawer__hint {
    text-align: center;
  }
</style>
