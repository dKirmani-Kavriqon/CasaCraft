---
/* Casa Craft mark: the bronze arch with a "C", redrawn as vector from the brand's posts. */
interface Props {
  size?: 'sm' | 'lg';
  withWordmark?: boolean;
}
const { size = 'sm', withWordmark = true } = Astro.props;
const id = `g${Math.random().toString(36).slice(2, 8)}`;
---
<span class:list={['logo', `logo--${size}`]}>
  <svg class="logo__mark" viewBox="0 0 40 48" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#c9a066" />
        <stop offset=".55" stop-color="#9a7038" />
        <stop offset="1" stop-color="#6e4d22" />
      </linearGradient>
    </defs>
    <path d="M0 48V20C0 8.95 8.95 0 20 0s20 8.95 20 20v28z" fill={`url(#${id})`} />
    <path
      d="M27.6 17.2a10 10 0 1 0 0 15.6"
      fill="none"
      stroke="#fbf6ee"
      stroke-width="4.2"
      stroke-linecap="butt"
    />
  </svg>
  {
    withWordmark && (
      <span class="logo__word">
        <span class="logo__name">Casa Craft</span>
        <span class="logo__sub">Interiors</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
  }
  .logo__mark {
    width: 26px;
    height: auto;
    flex: none;
  }
  .logo__word {
    display: grid;
    line-height: 1;
  }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.32rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .logo__sub {
    margin-top: 3px;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .logo--lg .logo__mark {
    width: 54px;
  }
  .logo--lg .logo__name {
    font-size: 2.4rem;
  }
  .logo--lg .logo__sub {
    font-size: 0.8rem;
    margin-top: 6px;
  }
</style>
